# Database Configuration for Olist E-Commerce Pipeline
# Copy this file to .env and fill in your actual credentials.
# Note: Never commit your actual .env file with secrets to version control.

DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=olist
DB_USER=postgres
DB_PASSWORD=your_password_here

# SQLite Fallback (Optional):
# If PostgreSQL is not available, you can set DB_TYPE=sqlite
# and specify a local database path:
SQLITE_DB_PATH=data/olist.db
